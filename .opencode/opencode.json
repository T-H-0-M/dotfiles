{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "permission": {
        "edit": "ask",
        "write": "ask",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch": "allow",
          "git branch --show-current": "allow",
          "git rev-parse*": "allow",
          "git ls-files*": "allow",
          "git grep*": "allow",
          "ls*": "allow",
          "pwd": "allow",
          "whoami": "allow",
          "uname*": "allow",
          "id*": "allow",
          "rg*": "allow",
          "*|*": "ask",
          "*>*": "ask",
          "*>>*": "ask",
          "*&&*": "ask",
          "*||*": "ask",
          "*;*": "ask"
        }
      }
    }
  }
}
