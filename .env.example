# Dotfiles Environment Configuration
# Copy this file to .env and fill in your personal values
# cp .env.example .env

# ============================================================================
# USER INFORMATION
# ============================================================================

# Your macOS username (e.g., john, jane)
DOTFILES_USER=

# Your computer hostname (check with: scutil --get ComputerName)
DOTFILES_HOSTNAME=

# Your full name for git commits and other configurations
DOTFILES_FULLNAME=

# Your email address
DOTFILES_EMAIL=

# ============================================================================
# NEOVIM CONFIGURATION
# ============================================================================

# Namespace for Neovim Lua configuration (replaces 'thomas' in lua/thomas/)
# Use your username or preferred namespace (lowercase, no spaces)
NVIM_NAMESPACE=

# ============================================================================
# PYTHON CONFIGURATION
# ============================================================================

# Python version for user-installed packages
PYTHON_VERSION=3.11

# ============================================================================
# OBSIDIAN VAULTS (Optional)
# ============================================================================

# Path to your personal Obsidian vault (leave empty if not using Obsidian)
OBSIDIAN_PERSONAL_VAULT=

# Path to your work Obsidian vault (leave empty if not using Obsidian)
OBSIDIAN_WORK_VAULT=

# ============================================================================
# DEVELOPMENT PATHS
# ============================================================================

# LM Studio CLI path (leave as default unless you have a custom installation)
LM_STUDIO_PATH="${HOME}/.cache/lm-studio/bin"

# Go binary path (leave as default unless custom Go installation)
GO_BIN_PATH="${HOME}/go/bin"

# MacTeX binary path (leave as default unless custom LaTeX installation)
MACTEX_PATH="/usr/local/texlive/2025/bin/universal-darwin"

# ============================================================================
# ANDROID DEVELOPMENT (Optional)
# ============================================================================

# Android SDK Home (leave as default unless custom installation)
ANDROID_HOME="${HOME}/Library/Android/sdk"

# ============================================================================
# TMUX CONFIGURATION
# ============================================================================

# Tmux status bar session name
TMUX_STATUS_SESSION_NAME="tmux"

# Tmux status bar background colour (hex colour)
TMUX_STATUS_BG="#53575e"

# Tmux status bar foreground colour (hex colour)
TMUX_STATUS_FG="#000000"
